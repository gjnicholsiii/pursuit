{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": { "deploymentEnabled": true },
  "functions": {
    "app/api/cron/lv-contracts/route.ts": { "maxDuration": 300 },
    "app/api/cron/lv-ionwave/route.ts": { "maxDuration": 300 },
    "app/api/cron/lv-opengov/route.ts": { "maxDuration": 300 },
    "app/api/cron/lv-periscope/route.ts": { "maxDuration": 300 },
    "app/api/cron/lv-sam/route.ts": { "maxDuration": 300 }
  },
  "crons": [
    { "path": "/api/cron/lv-contracts", "schedule": "15 6 * * *" },
    { "path": "/api/cron/lv-sam", "schedule": "0 7 * * *" },
    { "path": "/api/cron/lv-opengov", "schedule": "10 * * * *" },
    { "path": "/api/cron/lv-periscope", "schedule": "25 */2 * * *" },
    { "path": "/api/cron/lv-ionwave", "schedule": "40 */2 * * *" }
  ]
}
